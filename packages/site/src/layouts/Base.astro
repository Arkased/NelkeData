---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  /** The name of the page; the root page has none. */
  name?: string;
  /** False on the About page, which shows the notice in its own section. */
  showLegal?: boolean;
}
const { name, showLegal = true } = Astro.props;
const siteName = 'Westwald Archive';
const title = name ? `${name} · ${siteName}` : siteName;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
  </head>
  <body>
    <div class="page">
      <Header />
      <main>
        <slot />
      </main>
      <Footer showLegal={showLegal} />
    </div>
  </body>
</html>
