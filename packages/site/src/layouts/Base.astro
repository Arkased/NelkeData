---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Modal from '../components/Modal.astro';
import '../styles/global.css';
import '../styles/detail.css';

/** The props of the layout. */
interface Props {
  /** The name of the page; the title is `<name> · Westwald Archive`. The root page has none. */
  name?: string;
  /** The key of the category page that the page belongs to, for the header. */
  category?: string;
  /** False on the About page, which shows the notice in its own section. */
  showLegal?: boolean;
}

const { name, category, showLegal = true } = Astro.props;
const siteName = 'Westwald Archive';
const title = name ? `${name} · ${siteName}` : siteName;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
  </head>
  <body>
    <div class="page">
      <Header category={category} />
      <main>
        <slot />
      </main>
      <Footer showLegal={showLegal} />
    </div>
    <Modal />
  </body>
</html>
