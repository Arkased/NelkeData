---
import Filters from '../../components/Filters.astro';
import IconGrid from '../../components/IconGrid.astro';
import Tile from '../../components/Tile.astro';
import { CharacterGroup, groupOf, hasCharacterPage } from '../../characters';
import { data } from '../../data';
import { EntityKind } from '../../entity';
import Base from '../../layouts/Base.astro';
import { CategoryKey } from '../../nav';

const characters = data.characters.filter(hasCharacterPage);
const groups = [
  { param: 'group', label: 'Group', options: Object.values(CharacterGroup).map((group) => ({ value: group, label: group })) },
];
---

<Base name="Characters" category={CategoryKey.Characters}>
  <Filters groups={groups} />
  <IconGrid>
    {characters.map((character) => (
      <Tile
        kind={EntityKind.Character}
        slug={character.slug}
        name={character.name}
        icon={character.icon}
        attrs={{ 'data-filterable': '', 'data-group': groupOf(character) }}
      />
    ))}
  </IconGrid>
</Base>
