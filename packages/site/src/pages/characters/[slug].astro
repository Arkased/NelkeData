---
import type { Character } from '@nelke/model';
import CharacterDetail from '../../components/CharacterDetail.astro';
import EntityPage from '../../components/EntityPage.astro';
import { hasCharacterPage } from '../../characters';
import { data } from '../../data';
import Base from '../../layouts/Base.astro';
import { CategoryKey } from '../../nav';

/** Returns the page of each character with a join event. */
export function getStaticPaths() {
  return data.characters.filter(hasCharacterPage).map((character) => ({ params: { slug: character.slug }, props: { character } }));
}

interface Props {
  character: Character;
}

const { character } = Astro.props;
---

<Base name={character.name} category={CategoryKey.Characters}>
  <EntityPage>
    <CharacterDetail character={character} />
  </EntityPage>
</Base>
