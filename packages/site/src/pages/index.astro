---
import { Shop } from '@nelke/model';
import Filters from '../components/Filters.astro';
import IconGrid from '../components/IconGrid.astro';
import Tile from '../components/Tile.astro';
import { data } from '../data';
import { EntityKind } from '../entity';
import { filterCategoryOf, ITEM_CATEGORIES, SHOPS } from '../item-filters';
import Base from '../layouts/Base.astro';
import { UiIcon } from '../ui-icon';

const shops = Object.values(Shop).filter((shop) => data.items.some((item) => item.shops.includes(shop)));
const groups = [
  { param: 'cat', label: 'Category', options: ITEM_CATEGORIES.map((c) => ({ value: c.name, label: c.name, icon: c.icon })) },
  { param: 'shop', label: 'Sold at', options: shops.map((shop) => ({ value: shop, label: SHOPS[shop].label, icon: SHOPS[shop].icon })) },
  { param: 'craft', label: 'Synthesis', options: [{ value: '1', label: 'Craftable', icon: UiIcon.CategoryCraftable }] },
];
---

<Base category="items">
  <Filters groups={groups} />
  <IconGrid>
    {data.items.map((item) => (
      <Tile
        kind={EntityKind.Item}
        slug={item.slug}
        name={item.name}
        icon={item.icon}
        attrs={{
          'data-filterable': '',
          'data-cat': filterCategoryOf(item),
          'data-shop': item.shops.join(' '),
          ...(item.recipeId === null ? {} : { 'data-craft': '1' }),
        }}
      />
    ))}
  </IconGrid>
</Base>
