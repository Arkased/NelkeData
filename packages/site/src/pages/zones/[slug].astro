---
import type { Zone } from '@nelke/model';
import EntityPage from '../../components/EntityPage.astro';
import ZoneDetail from '../../components/ZoneDetail.astro';
import { data } from '../../data';
import Base from '../../layouts/Base.astro';
import { CategoryKey } from '../../nav';

/** Returns the page of each zone. */
export function getStaticPaths() {
  return data.zones.map((zone) => ({ params: { slug: zone.slug }, props: { zone } }));
}

interface Props {
  zone: Zone;
}

const { zone } = Astro.props;
---

<Base name={zone.name} category={CategoryKey.Areas}>
  <EntityPage>
    <ZoneDetail zone={zone} />
  </EntityPage>
</Base>
