---
import Section from '../components/Section.astro';
import Base from '../layouts/Base.astro';
import { LEGAL_NOTICE } from '../legal';

const REPO_URL = 'https://github.com/Arkased/NelkeData';
---

<Base name="About" showLegal={false}>
  <div class="about-wrap">
    <div class="about">
      <Section title="Contact">
        <div class="text">
          <p>
            Errors and questions go to the{' '}
            <a class="text-link" href={`${REPO_URL}/issues`}>
              issues of the GitHub repository
            </a>
            .
          </p>
        </div>
      </Section>
      <Section title="Source">
        <div class="text">
          <p>
            <a class="text-link" href={REPO_URL}>
              {REPO_URL}
            </a>
          </p>
          <p>The data comes from the files of the Steam version of the game.</p>
        </div>
      </Section>
      <Section title="Legal">
        <div class="text">
          <p>
            {LEGAL_NOTICE.before}
            <i>{LEGAL_NOTICE.gameTitle}</i>
            {LEGAL_NOTICE.after}
          </p>
        </div>
      </Section>
    </div>
  </div>
</Base>

<style>
  .about-wrap {
    display: flex;
    justify-content: center;
  }
  .about {
    width: 100%;
    max-width: 720px;
    padding: var(--g);
    display: grid;
    gap: var(--g);
    border: 1px solid var(--brown);
    border-radius: var(--radius);
    background: var(--cream);
    font-size: var(--text-body);
    line-height: 1.5;
  }
  .text {
    padding-top: var(--s2);
    display: grid;
    gap: var(--s2);
    overflow-wrap: anywhere;
  }
</style>
