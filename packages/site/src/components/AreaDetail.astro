---
import type { Area } from '@nelke/model';
import { itemById, monsterById, zoneById } from '../data';
import { EntityKind } from '../entity';
import { formatLevels, formatRate } from '../format';
import ElementStat from './ElementStat.astro';
import EntityLink from './EntityLink.astro';
import Group from './Group.astro';
import OpensStat from './OpensStat.astro';
import RareFinds from './RareFinds.astro';
import Stat from './Stat.astro';
import Tile from './Tile.astro';

/** The props of the area detail. */
interface Props {
  area: Area;
}

const { area } = Astro.props;

function required<T>(row: T | undefined, what: string): T {
  if (row === undefined) throw new Error(`${area.id}: missing ${what}`);
  return row;
}

const zone = required(zoneById.get(area.zoneId), 'zone');
const gather = area.gather
  .toSorted((a, b) => b.rate - a.rate)
  .map((g) => ({ item: required(itemById.get(g.itemId), 'item'), badge: formatRate(g.rate) }));
const appearances = area.monsters.map((m) => ({
  monster: required(monsterById.get(m.monsterId), 'monster'),
  badge: formatLevels(m.levels),
  boss: m.boss,
  areaLevel: m.areaLevel,
}));
/** The monster groups in order: the monsters from the start, the monsters from each higher Investigation Lv, then the bosses. */
const monsterGroups = [
  { title: 'Monsters', list: appearances.filter((m) => !m.boss && m.areaLevel <= 1) },
  ...[...new Set(appearances.filter((m) => !m.boss && m.areaLevel > 1).map((m) => m.areaLevel))]
    .toSorted((a, b) => a - b)
    .map((level) => ({
      title: `Monsters from Investigation Lv ${level}`,
      list: appearances.filter((m) => !m.boss && m.areaLevel === level),
    })),
  { title: 'Bosses', list: appearances.filter((m) => m.boss) },
].filter((group) => group.list.length > 0);
const hasPanel = gather.length > 0 || monsterGroups.length > 0;
---

<div class="mhead">
  <h1 class="name">{area.name}</h1>
</div>

<div class="stats">
  <Stat label="Zone" id="zone" wrap>
    <EntityLink kind={EntityKind.Zone} slug={zone.slug} name={zone.name} />
  </Stat>
  <OpensStat zone={zone} />
  <Stat label="Difficulty by Investigation Lv" id="difficulty" wrap>
    {zone.difficulties.map((rank, index) => (
      <span class="dcell" data-difficulty-cell>
        <span>{rank}</span>
        <small>{index + 1}</small>
      </span>
    ))}
  </Stat>
  <ElementStat zone={zone} />
</div>

{hasPanel && (
  <div class="panel" data-section="area-panel">
    {gather.length > 0 && (
      <Group title="Gather">
        <div class="minis">
          {gather.map(({ item, badge }) => (
            <Tile kind={EntityKind.Item} slug={item.slug} name={item.name} icon={item.icon} badge={badge} />
          ))}
        </div>
      </Group>
    )}
    {monsterGroups.map((group) => (
      <Group title={group.title}>
        <div class="minis">
          {group.list.map(({ monster, badge }) => (
            <Tile kind={EntityKind.Monster} slug={monster.slug} name={monster.name} icon={monster.icon} badge={badge} />
          ))}
        </div>
      </Group>
    ))}
  </div>
)}

<RareFinds zone={zone} />
