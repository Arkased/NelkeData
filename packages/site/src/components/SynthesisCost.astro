---
import { formatNumber } from '../format';
import { uiIconUrl } from '../icons';
import { UiIcon } from '../ui-icon';

/** The props of a synthesis cost value. Without an amount, it shows only the icon. */
interface Props {
  amount?: number;
}

const { amount } = Astro.props;
---

<span class="unit">
  <img class="ico" src={uiIconUrl(UiIcon.SynthesisCost)} alt="Synthesis cost" width="16" height="16" />
  {amount !== undefined && formatNumber(amount)}
</span>
