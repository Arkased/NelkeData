---
import { EntityKind } from '../entity';
import EntityLink from './EntityLink.astro';

/** The props of an area entry. */
interface Props {
  /** The area or the zone that the entry names. */
  kind: EntityKind.Area | EntityKind.Zone;
  slug: string;
  name: string;
  /** The zone of an area, shown under the name; null for a zone entry. */
  zone?: { slug: string; name: string } | null;
  /** The badge: a rate or a level range; null for no badge. */
  badge?: string | null;
}

const { kind, slug, name, zone = null, badge = null } = Astro.props;
---

<div class="link">
  <span class="lt">
    <b>
      <EntityLink kind={kind} slug={slug} name={name} />
    </b>
    {zone !== null && (
      <small>
        <EntityLink kind={EntityKind.Zone} slug={zone.slug} name={zone.name} />
      </small>
    )}
  </span>
  {badge !== null && <span class="pct">{badge}</span>}
</div>
