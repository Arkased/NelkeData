---
import { entityIconUrl, iconCropClass } from '../icons';

/** The props of an entity icon. */
interface Props {
  /** The file name in `data/icons/128/`, or null when the entity has no icon. */
  icon: string | null;
  /** An extra class for the size. */
  class?: string;
}

const { icon, class: extra = '' } = Astro.props;
---

<span class:list={['slot', icon === null ? '' : iconCropClass(icon), extra]}>
  {icon !== null && <img src={entityIconUrl(icon)} alt="" width="128" height="128" loading="lazy" />}
  <slot />
</span>
