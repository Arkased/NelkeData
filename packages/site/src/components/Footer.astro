---
import { LEGAL_NOTICE } from '../legal';
import { pageUrl } from '../url';

interface Props {
  showLegal: boolean;
}
const { showLegal } = Astro.props;
---

{showLegal && (
  <footer class="foot">
    <p>
      <span class="legal">
        {LEGAL_NOTICE.before}
        <i>{LEGAL_NOTICE.gameTitle}</i>
        {LEGAL_NOTICE.after}
      </span>{' '}
      <a class="text-link" href={pageUrl('about/')}>
        About
      </a>
    </p>
  </footer>
)}

<style>
  .foot {
    text-align: center;
    font-size: var(--text-small);
    line-height: 1.5;
    color: var(--ink-soft);
    padding: var(--g) 0;
  }
  .legal {
    display: block;
  }
</style>
