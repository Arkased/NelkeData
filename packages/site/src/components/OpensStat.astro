---
import type { Zone } from '@nelke/model';
import Stat from './Stat.astro';

/** The props of the stat "Opens". */
interface Props {
  zone: Zone;
}

const { zone } = Astro.props;
---

<Stat label="Opens" id="opens" wrap>
  {zone.task === null ? 'From the start' : `After task ${zone.task.number}: ${zone.task.name}`}
</Stat>
