---
import { Element, type Item } from '@nelke/model';
import { areaById, characterById, data, itemById, monsterById, recipeById, recipeSetById, researchById, zoneById } from '../data';
import { EntityKind, entityUrl } from '../entity';
import { formatNumber, formatRate } from '../format';
import { entityIconUrl, uiIconUrl } from '../icons';
import { categoryIconOf, SHOPS } from '../item-filters';
import EntityLink from './EntityLink.astro';
import Friendship from './Friendship.astro';
import Group from './Group.astro';
import Icon from './Icon.astro';
import Money from './Money.astro';
import Section from './Section.astro';
import Stat from './Stat.astro';
import SynthesisCost from './SynthesisCost.astro';
import Tile from './Tile.astro';

/** The props of the item detail. */
interface Props {
  item: Item;
}

const { item } = Astro.props;

function required<T>(row: T | undefined, what: string): T {
  if (row === undefined) throw new Error(`${item.id}: missing ${what}`);
  return row;
}

const categoryText =
  item.subCategory === null
    ? item.category
    : item.subCategory.toLowerCase().includes(item.category.toLowerCase())
      ? item.subCategory
      : `${item.category} · ${item.subCategory}`;

const elements = Object.values(Element)
  .map((element) => ({ value: item.reduce[element] ?? 0, item: data.items.find((i) => i.name === `${element} Element`) }))
  .filter((e) => e.value > 0 && e.item !== undefined);

const recipe = item.recipeId === null ? null : required(recipeById.get(item.recipeId), 'recipe');
const unlocks = (recipe?.recipeSetIds ?? []).map((id) => {
  const set = required(recipeSetById.get(id), 'recipe set');
  const research = set.researchId === null ? null : required(researchById.get(set.researchId), 'research');
  const firstRecipe = recipeById.get(set.recipeIds[0] ?? '');
  return {
    set,
    showSetName: set.name !== item.name,
    teacher: set.teacherId === null ? null : required(characterById.get(set.teacherId), 'teacher'),
    research,
    researcher: research?.researcherId == null ? null : characterById.get(research.researcherId),
    researchIcon: itemById.get(firstRecipe?.resultItemId ?? '')?.icon ?? null,
    event: set.unlockEvent !== null && set.unlockEvent.label !== set.unlockEvent.id ? set.unlockEvent.label : null,
  };
});
const hasUnlock = unlocks.some((u) => u.showSetName || u.teacher !== null || u.research !== null || u.event !== null);

const gathers = item.gather
  .toSorted((a, b) => b.rate - a.rate)
  .map((g) => {
    const area = required(areaById.get(g.areaId), 'area');
    return { area, zone: required(zoneById.get(area.zoneId), 'zone'), rate: formatRate(g.rate) };
  });
const drops = item.drops.map((d) => required(monsterById.get(d.monsterId), 'monster'));
const specialZones = item.specialZoneIds.map((id) => required(zoneById.get(id), 'zone'));
const usedIn = item.usedInRecipeIds.map((id) => required(itemById.get(required(recipeById.get(id), 'recipe').resultItemId), 'item'));
const hasHowToGet = gathers.length > 0 || drops.length > 0 || specialZones.length > 0 || item.growingArea !== null;
---

<div class="mhead">
  <h1 class="name">{item.name}</h1>
</div>

<div class="top">
  <Icon icon={item.icon} class="big" />
  <div class="facts">
    <span class="catline">
      <img class="cat" src={uiIconUrl(categoryIconOf(item))} alt="" width="24" height="24" />
      {categoryText}
    </span>
    {item.price > 0 && (
      <span class="price" data-fact="price">
        <Money amount={item.price} />
      </span>
    )}
    {item.shops.length > 0 && (
      <span class="sold" data-fact="sold-at">
        <small class="cap">Sold at</small>
        {item.shops.map((shop) => (
          <span class="shop">
            <img src={uiIconUrl(SHOPS[shop].icon)} alt="" width="24" height="24" />
            {SHOPS[shop].label}
          </span>
        ))}
      </span>
    )}
    {elements.length > 0 && (
      <span class="reduce" data-fact="reduces-into">
        <small class="cap">Reduces into</small>
        <span class="els">
          {elements.map((element) => {
            const target = required(element.item, 'element item');
            const href = entityUrl(EntityKind.Item, target.slug);
            return (
              <a class="el" href={href} data-modal title={target.name}>
                <img src={entityIconUrl(required(target.icon, 'element icon'))} alt={target.name} width="24" height="24" />
                <b>{formatNumber(element.value)}</b>
              </a>
            );
          })}
        </span>
      </span>
    )}
  </div>
</div>

{item.description !== null && <p class="desc">{item.description}</p>}

{recipe !== null && (
  <Section title="Synthesis">
    <div class="syn" data-section="synthesis">
      <div class="minis">
        {recipe.materials.map((m) => {
          const material = required(itemById.get(m.itemId), 'material');
          return <Tile kind={EntityKind.Item} slug={material.slug} name={material.name} icon={material.icon} qty={m.quantity} />;
        })}
      </div>
      <div class="syn-stats">
        <Stat label="Synth. Lv." id="synth-level">
          Lv {recipe.synthesisLevel}
        </Stat>
        <Stat label="Synthesis cost" id="synthesis-cost">
          <SynthesisCost amount={recipe.synthesisCost} />
        </Stat>
        {recipe.addedValue !== null && (
          <Stat label="Selling price" id="selling-price">
            <Money amount={item.price} />
          </Stat>
        )}
        <Stat label="Material cost" id="material-cost">
          <Money amount={recipe.inputCost} />
        </Stat>
        {recipe.addedValue !== null && (
          <Stat label="Added value" id="added-value" tone={recipe.addedValue > 0 ? 'good' : recipe.addedValue < 0 ? 'bad' : undefined}>
            <Money amount={recipe.addedValue} />
          </Stat>
        )}
        {recipe.addedValuePerCost !== null && (
          <Stat label="Value per cost" id="value-per-cost">
            <Money amount={recipe.addedValuePerCost} />
            <span class="per">per</span>
            <SynthesisCost />
          </Stat>
        )}
      </div>
      {recipe.unpricedItemIds.length > 0 && (
        <div class="ul">
          <small class="cap">Counted as 0 (no price)</small>
          <span class="uv wrap">
            {recipe.unpricedItemIds.map((id) => {
              const material = required(itemById.get(id), 'unpriced item');
              return <EntityLink kind={EntityKind.Item} slug={material.slug} name={material.name} icon={material.icon} />;
            })}
          </span>
        </div>
      )}
      {hasUnlock && (
        <div class="unlock" data-section="unlock">
          {unlocks.map((u) => (
            <>
              {u.showSetName && (
                <div class="ul">
                  <small class="cap">Recipe set</small>
                  <span class="uv">{u.set.name}</span>
                </div>
              )}
              {u.teacher !== null && (
                <div class="ul">
                  <small class="cap">Taught by</small>
                  <span class="uv">
                    <Icon icon={u.teacher.icon} class="face" />
                    <EntityLink kind={EntityKind.Character} slug={u.teacher.slug} name={u.teacher.name} />
                    {u.set.friendship !== null && u.set.friendship > 0 && <Friendship level={u.set.friendship} />}
                  </span>
                </div>
              )}
              {u.research !== null && (
                <div class="ul">
                  <small class="cap">Research</small>
                  <span class="uv wrap">
                    <EntityLink kind={EntityKind.Research} slug={u.research.slug} name={u.research.name} icon={u.researchIcon} />
                    {u.researcher != null && <span class="note">{u.researcher.name}</span>}
                  </span>
                </div>
              )}
              {u.event !== null && (
                <div class="ul">
                  <small class="cap">Event</small>
                  <span class="uv">{u.event}</span>
                </div>
              )}
            </>
          ))}
        </div>
      )}
    </div>
  </Section>
)}

{hasHowToGet && (
  <Section title="How to get">
    <div class="groups" data-section="how-to-get">
      {gathers.length > 0 && (
        <Group title="Gather">
          <div class="cols">
            {gathers.map((g) => (
              <div class="link">
                <span class="lt">
                  <b>
                    <EntityLink kind={EntityKind.Area} slug={g.area.slug} name={g.area.name} />
                  </b>
                  <small>
                    <EntityLink kind={EntityKind.Zone} slug={g.zone.slug} name={g.zone.name} />
                  </small>
                </span>
                {g.rate !== null && <span class="pct">{g.rate}</span>}
              </div>
            ))}
          </div>
        </Group>
      )}
      {drops.length > 0 && (
        <Group title="Monster drops">
          <div class="minis">
            {drops.map((monster) => (
              <Tile kind={EntityKind.Monster} slug={monster.slug} name={monster.name} icon={monster.icon} />
            ))}
          </div>
        </Group>
      )}
      {specialZones.length > 0 && (
        <Group title="Special spots">
          <div class="cols">
            {specialZones.map((zone) => (
              <div class="link">
                <span class="lt">
                  <b>
                    <EntityLink kind={EntityKind.Zone} slug={zone.slug} name={zone.name} />
                  </b>
                </span>
              </div>
            ))}
          </div>
        </Group>
      )}
      {item.growingArea !== null && (
        <Group title="Farm">
          <div class="chips">
            <span class="chip">{item.growingArea}</span>
          </div>
        </Group>
      )}
    </div>
  </Section>
)}

{usedIn.length > 0 && (
  <Section title="Used in">
    <div class="minis" data-section="used-in">
      {usedIn.map((user) => (
        <Tile kind={EntityKind.Item} slug={user.slug} name={user.name} icon={user.icon} />
      ))}
    </div>
  </Section>
)}
