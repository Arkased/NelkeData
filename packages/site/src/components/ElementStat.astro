---
import type { Zone } from '@nelke/model';
import { elementItem } from '../elements';
import { EntityKind } from '../entity';
import EntityLink from './EntityLink.astro';
import Stat from './Stat.astro';

/** The props of the stat "Area element". */
interface Props {
  zone: Zone;
}

const { zone } = Astro.props;
---

{zone.elements.length > 0 && (
  <Stat label="Area element" id="area-element" wrap>
    {zone.elements.map((element) => {
      const item = elementItem(element);
      return <EntityLink kind={EntityKind.Item} slug={item.slug} name={element} icon={item.icon} />;
    })}
  </Stat>
)}
