---
import type { StatTone } from '../stat-tone';

/** The props of a stat. */
interface Props {
  /** The small label above the value. */
  label: string;
  /** A name for the UI test to find the stat. */
  id: string;
  /** A tone for the value: `good` is green, `bad` is red. */
  tone?: StatTone;
  /** True when the value may wrap onto more lines, for a text or a list. */
  wrap?: boolean;
}

const { label, id, tone, wrap = false } = Astro.props;
---

<div class:list={['stat', tone]} data-stat={id}>
  <small class="cap">{label}</small>
  <b class:list={['val', { wrap }]}>
    <slot />
  </b>
</div>
