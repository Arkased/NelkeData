---
import { entityUrl, type EntityKind } from '../entity';
import { entityIconUrl, uiIconUrl } from '../icons';
import type { UiIcon } from '../ui-icon';

/** The props of an entity link. */
interface Props {
  kind: EntityKind;
  slug: string;
  name: string;
  /** The file name in `data/icons/128/`, or null when the entity has no icon. */
  icon?: string | null;
  /** The UI icon of the game for an entity that has no icon of its own; `icon` wins when both are set. */
  uiIcon?: UiIcon;
  /** False for an entity of a kind with pages that has no page itself, for example a character with no join event. */
  linked?: boolean;
}

const { kind, slug, name, icon = null, uiIcon, linked = true } = Astro.props;
const iconUrl = icon !== null ? entityIconUrl(icon) : uiIcon === undefined ? null : uiIconUrl(uiIcon);
const href = linked ? entityUrl(kind, slug) : null;
const Tag = href === null ? 'span' : 'a';
---

<Tag class="tl" href={href} data-modal={href === null ? undefined : ''}>
  {iconUrl !== null && <img class="ico" src={iconUrl} alt="" width="24" height="24" loading="lazy" />}
  {name}
</Tag>
