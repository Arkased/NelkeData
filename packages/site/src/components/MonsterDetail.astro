---
import { CharacterType, Element, type Monster } from '@nelke/model';
import { mergeLevels } from '../appearances';
import { areaById, itemById, zoneById } from '../data';
import { ELEMENT_ITEM_IDS } from '../element-items';
import { EntityKind } from '../entity';
import { formatLevelRange, formatNumber } from '../format';
import { entityIconUrl } from '../icons';
import AreaEntry from './AreaEntry.astro';
import Icon from './Icon.astro';
import Section from './Section.astro';
import Tile from './Tile.astro';

/** The props of the monster detail. */
interface Props {
  monster: Monster;
}

const { monster } = Astro.props;

function required<T>(row: T | undefined, what: string): T {
  if (row === undefined) throw new Error(`${monster.id}: missing ${what}`);
  return row;
}

const defense = Object.values(Element).flatMap((element) => {
  const value = monster.elementDef?.[element];
  if (value === undefined) return [];
  const item = required(itemById.get(ELEMENT_ITEM_IDS[element]), `${element} element item`);
  return [{ value, name: item.name, icon: required(item.icon, 'element icon') }];
});
const drops = monster.drops.map((drop) => ({ drop, item: required(itemById.get(drop.itemId), 'drop item') }));
const areas = mergeLevels(monster.areas, (appearance) => appearance.areaId).map((appearance) => {
  const area = required(areaById.get(appearance.id), 'area');
  return { area, zone: required(zoneById.get(area.zoneId), 'zone'), levels: formatLevelRange(appearance.levels) };
});
const zones = mergeLevels(monster.zoneEncounters, (encounter) => encounter.zoneId).map((encounter) => ({
  zone: required(zoneById.get(encounter.id), 'zone'),
  levels: formatLevelRange(encounter.levels),
}));
---

<div class="mhead">
  <h1 class="name">{monster.name}</h1>
</div>

<div class="top">
  <Icon icon={monster.icon} class="big" />
  <div class="facts">
    <span class="catline" data-fact="type">
      {monster.type === CharacterType.Boss ? 'Boss' : 'Monster'}
    </span>
    {defense.length > 0 && (
      <span class="reduce" data-fact="element-def">
        <small class="cap">Element DEF</small>
        <span class="els">
          {defense.map((element) => (
            <span class="el" title={element.name}>
              <img src={entityIconUrl(element.icon)} alt={element.name} width="24" height="24" />
              <b>{formatNumber(element.value)}</b>
            </span>
          ))}
        </span>
      </span>
    )}
  </div>
</div>

{monster.description !== null && <p class="desc">{monster.description}</p>}

{drops.length > 0 && (
  <Section title="Drops">
    <div class="minis" data-section="drops">
      {drops.map(({ drop, item }) => (
        <Tile kind={EntityKind.Item} slug={item.slug} name={item.name} icon={item.icon} qty={drop.quantity} />
      ))}
    </div>
  </Section>
)}

{(areas.length > 0 || zones.length > 0) && (
  <Section title="Found in">
    <div class="cols" data-section="found-in">
      {areas.map((entry) => (
        <AreaEntry kind={EntityKind.Area} slug={entry.area.slug} name={entry.area.name} zone={entry.zone} badge={entry.levels} />
      ))}
      {zones.map((entry) => (
        <AreaEntry kind={EntityKind.Zone} slug={entry.zone.slug} name={entry.zone.name} badge={entry.levels} />
      ))}
    </div>
  </Section>
)}
