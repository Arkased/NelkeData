---
import { uiIconUrl } from '../icons';
import type { UiIcon } from '../ui-icon';

/** A toggle of a filter group. */
interface FilterOption {
  value: string;
  label: string;
  /** The icon of the game for the option; absent when the game has none. */
  icon?: UiIcon;
}

/** A group of toggles. */
interface FilterGroup {
  /** The name of the query parameter, and of the `data-` attribute of the grid cells that holds their values. */
  param: string;
  label: string;
  options: FilterOption[];
}

/** The props of the filters. */
interface Props {
  groups: FilterGroup[];
}

const { groups } = Astro.props;
---

<div class="toolbar" data-filters>
  <div class="srow">
    <button class="btn ftoggle" type="button" aria-expanded="false" aria-controls="fpanel" data-filters-toggle>
      <span>Filters</span>
      <b class="badge" hidden data-filters-count>
        0
      </b>
    </button>
    <button class="btn" type="button" hidden data-clear>
      Clear filters
    </button>
  </div>
  <div class="fpanel" id="fpanel">
    {groups.map((group) => (
      <div class="fgroup">
        <span class="cap">{group.label}</span>
        <div class="opts" data-param={group.param}>
          {group.options.map((option) => (
            <button class="toggle" type="button" data-value={option.value} aria-pressed="false">
              {option.icon !== undefined && <img class="cat" src={uiIconUrl(option.icon)} alt="" width="24" height="24" />}
              <span>{option.label}</span>
            </button>
          ))}
        </div>
      </div>
    ))}
  </div>
</div>

<script>
  import '../scripts/filters';
</script>

<style>
  .toolbar {
    background: var(--cream);
    border: 1px solid var(--brown);
    border-radius: var(--radius);
    padding: var(--g);
    display: grid;
    gap: var(--s3);
  }
  .fpanel {
    display: grid;
    gap: var(--s3);
  }
  .fgroup {
    display: grid;
    grid-template-columns: 88px 1fr;
    gap: var(--s2) var(--s3);
    align-items: start;
  }
  .fgroup > .cap {
    min-height: 40px;
    display: flex;
    align-items: center;
  }
  .opts {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s2);
    align-items: center;
  }
  .srow {
    display: flex;
    align-items: center;
    gap: var(--s3);
    flex-wrap: wrap;
  }
  .srow:has([data-clear][hidden]) {
    display: none;
  }
  .ftoggle {
    display: none;
    align-items: center;
    gap: var(--s2);
  }
  .toggle {
    display: inline-flex;
    align-items: center;
    gap: var(--s2);
    min-height: 40px;
    padding: var(--s1) var(--s3);
    font-weight: 700;
    text-align: left;
    max-width: 100%;
    color: var(--ink);
    background: var(--cream-2);
    border: 2px solid var(--line);
    border-radius: var(--radius);
  }
  .toggle:hover {
    background: var(--gold-soft);
  }
  .toggle[aria-pressed='true'] {
    background: var(--gold);
    border-color: var(--warm);
  }
  .cat {
    width: 24px;
    height: 24px;
    object-fit: contain;
    flex: none;
  }
  .badge {
    display: inline-grid;
    place-items: center;
    min-width: 20px;
    height: 20px;
    padding: 0 var(--s1);
    border-radius: var(--s2);
    background: var(--warm);
    color: var(--white);
    font-size: var(--text-small);
    line-height: 1;
  }
  .badge[hidden] {
    display: none;
  }
  @media (max-width: 640px) {
    .fgroup {
      grid-template-columns: 1fr;
    }
    .fgroup > .cap {
      min-height: 0;
    }
  }
  @media (max-width: 599px) {
    .ftoggle {
      display: inline-flex;
    }
    .srow:has([data-clear][hidden]) {
      display: flex;
    }
    .toolbar:not(.fopen) .fpanel {
      display: none;
    }
  }
</style>
